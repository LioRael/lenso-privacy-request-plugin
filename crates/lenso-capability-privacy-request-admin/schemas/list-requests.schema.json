{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["organization_id", "limit"],
  "properties": {
    "organization_id": { "type": "string" },
    "state": { "type": "string", "enum": ["pending_verification", "ready", "claimed", "processing", "awaiting_completion", "paused", "completed", "rejected", "withdrawn", "failed"] },
    "kind": { "type": "string", "enum": ["access", "export", "erasure", "correction", "restriction"] },
    "requester_subject": { "type": "string" },
    "cursor": { "type": "string" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
  },
  "additionalProperties": false
}
