{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostgreSQL Privacy Request Plugin configuration",
  "type": "object",
  "required": ["schema", "database_url_secret", "auth_issuer", "auth_assertion_public_key", "public_callers", "admin_callers", "worker_callers"],
  "properties": {
    "schema": { "type": "string", "minLength": 1, "maxLength": 63 },
    "database_url_secret": { "type": "string", "minLength": 1, "maxLength": 256 },
    "auth_issuer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "auth_assertion_public_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "public_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "admin_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "worker_callers": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "deadline_seconds": { "type": "integer", "minimum": 3600, "maximum": 31536000, "default": 2592000 },
    "max_sources": { "type": "integer", "minimum": 1, "maximum": 100, "default": 32 },
    "max_participants": { "type": "integer", "minimum": 1, "maximum": 100, "default": 32 },
    "max_process_steps_per_call": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
    "max_items_per_provider": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 },
    "max_total_items": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1000 },
    "max_item_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608, "default": 1048576 },
    "max_total_export_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608, "default": 4194304 },
    "process_lease_seconds": { "type": "integer", "minimum": 60, "maximum": 3600, "default": 900 }
  },
  "additionalProperties": false
}
