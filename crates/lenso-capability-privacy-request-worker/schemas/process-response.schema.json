{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["request", "steps", "next_cursor", "completed_steps", "failed_steps", "pending_steps", "all_steps_completed"],
  "properties": {
    "request": { "$ref": "request-response.schema.json" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "provider_kind", "provider_instance", "status", "attempts", "error_code"],
        "properties": {
          "sequence": { "type": "integer" }, "provider_kind": { "type": "string", "enum": ["export", "retention", "manual"] },
          "provider_instance": { "type": "string" }, "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
          "attempts": { "type": "integer" }, "error_code": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "next_cursor": { "type": ["string", "null"] }, "completed_steps": { "type": "integer" }, "failed_steps": { "type": "integer" }, "pending_steps": { "type": "integer" }, "all_steps_completed": { "type": "boolean" }
  },
  "additionalProperties": false
}
